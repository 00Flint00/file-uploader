# Allow PHP execution in API directory but protect internal files
<FilesMatch "\.(json|log|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes
